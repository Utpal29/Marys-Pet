---
// Loopy hand-drawn arrow, pointing down-right by default.
interface Props { class?: string }
const { class: className } = Astro.props;
---
<svg class:list={['arrow', className]} viewBox="0 0 120 96" fill="none" aria-hidden="true">
  <path d="M8 14c26-10 58-6 62 12 3 14-16 16-14 4 3-16 34-10 42 22 3 12 2 22 0 30" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M84 70l15 14 11-19" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
</svg>
