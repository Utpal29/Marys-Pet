---
interface Props { class?: string; style?: string }
const { class: className, style } = Astro.props;
---
<svg class:list={['paw', className]} style={style} viewBox="0 0 24 24" aria-hidden="true">
  <g fill="currentColor">
    <ellipse cx="12" cy="16.2" rx="5.2" ry="4.4" />
    <ellipse cx="4.6" cy="10" rx="2.3" ry="2.7" transform="rotate(-18 4.6 10)" />
    <ellipse cx="9.2" cy="5.2" rx="2.3" ry="2.8" transform="rotate(-6 9.2 5.2)" />
    <ellipse cx="14.8" cy="5.2" rx="2.3" ry="2.8" transform="rotate(6 14.8 5.2)" />
    <ellipse cx="19.4" cy="10" rx="2.3" ry="2.7" transform="rotate(18 19.4 10)" />
  </g>
</svg>
