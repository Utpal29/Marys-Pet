---
import { steps } from '../data/site';
import poodleApricot from '../assets/stickers/poodle-apricot.png';
import Icon from './Icon.astro';
import Sticker from './Sticker.astro';
import Paw from './doodles/Paw.astro';

const icons = ['phone', 'home', 'heart'] as const;
---
<section class="steps-section" aria-labelledby="steps-title">
  <div class="wrap">
    <h2 id="steps-title">How a visit works</h2>
    <p class="sub">No online forms. Just reach out and Mary will sort out a time.</p>

    <ol class="steps">
      {steps.map((s, i) => (
        <li>
          <span class="circle"><Icon name={icons[i]} size={30} /><span class="n">{i + 1}</span></span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
          {i < steps.length - 1 && (
            <span class="trail" aria-hidden="true">
              <Paw /><Paw /><Paw />
            </span>
          )}
        </li>
      ))}
    </ol>
    <Sticker src={poodleApricot} width={150} class="happy" />
  </div>
</section>

<style>
  .steps-section { padding-top: 40px; }
  .steps-section .wrap { position: relative; }
  .steps { list-style: none; display: grid; gap: 58px; margin-top: 10px; }
  li { position: relative; display: grid; grid-template-columns: 76px 1fr; gap: 18px; align-items: start; }
  .circle {
    position: relative;
    width: 76px; height: 76px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--bubble);
    box-shadow: inset 0 -5px 0 rgba(58, 29, 60, .08);
  }
  li:nth-child(2) .circle { background: var(--mint); }
  li:nth-child(3) .circle { background: var(--butter); }
  .n {
    position: absolute; top: -4px; right: -4px;
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--plum); color: var(--paper);
    display: grid; place-items: center;
    font-family: var(--display); font-weight: 600; font-size: 15px;
  }
  h3 { font-size: 24px; line-height: 1.2; margin: 8px 0 4px; }
  li p { color: var(--plum-soft); max-width: 34ch; }

  /* Little footprints walking to the next step */
  .trail {
    position: absolute; left: 26px; top: 88px;
    display: flex; flex-direction: column; gap: 4px;
    color: var(--bubble-deep);
  }
  .trail :global(svg) { width: 17px; rotate: 180deg; }
  .trail :global(svg:nth-child(even)) { translate: 12px 0; }

  .happy { width: 110px; margin: 14px 0 0 auto; rotate: 6deg; }

  @media (min-width: 900px) {
    .steps { grid-template-columns: repeat(3, 1fr); gap: 60px; }
    li { grid-template-columns: 1fr; gap: 12px; }
    .trail { flex-direction: row; left: 96px; top: 24px; gap: 8px; }
    .trail :global(svg) { rotate: 90deg; }
    .trail :global(svg:nth-child(even)) { translate: 0 12px; }
    .happy { position: absolute; right: 10px; top: -30px; width: 150px; margin: 0; }
  }
</style>
