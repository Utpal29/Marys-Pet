---
import { business } from '../data/site';
import Icon from './Icon.astro';
import Sparkle from './doodles/Sparkle.astro';
---
<div class="closing-wrap">
  <!-- A pup peeking over the edge. Its head sits behind the section so the scallops hide its neck. -->
  <div class="mascot" data-mascot aria-hidden="true">
    <svg class="head" viewBox="0 0 240 170">
      <g stroke="#3A1D3C" stroke-width="4" stroke-linejoin="round" stroke-linecap="round">
        <path class="ear ear-l" d="M74 60C46 48 24 78 30 118c3 20 22 24 30 10 6-12 4-32 16-46z" fill="#C98E5F" />
        <path class="ear ear-r" d="M166 60c28-12 50 18 44 58-3 20-22 24-30 10-6-12-4-32-16-46z" fill="#C98E5F" />
        <ellipse cx="120" cy="106" rx="66" ry="60" fill="#F7E1C3" />
        <path d="M106 50c4-16 10-18 14-6 4-14 12-12 14 6" fill="#F7E1C3" />
        <ellipse cx="120" cy="130" rx="30" ry="22" fill="#FFF5E8" stroke="none" />
        <g class="eyes" fill="#3A1D3C" stroke="none">
          <ellipse cx="94" cy="102" rx="7.5" ry="9.5" />
          <ellipse cx="146" cy="102" rx="7.5" ry="9.5" />
          <circle cx="96.5" cy="98" r="2.6" fill="#fff" />
          <circle cx="148.5" cy="98" r="2.6" fill="#fff" />
        </g>
        <ellipse cx="80" cy="122" rx="10" ry="6" fill="#F6A9C6" stroke="none" opacity=".75" />
        <ellipse cx="160" cy="122" rx="10" ry="6" fill="#F6A9C6" stroke="none" opacity=".75" />
        <path d="M110 119q10-7 20 0-4 11-10 11t-10-11z" fill="#3A1D3C" />
        <path d="M113 138c0 13 14 13 14 0z" fill="#F58FB6" stroke-width="3" />
        <path d="M120 130v6m0 0c-4 6-10 6-14 1m14-1c4 6 10 6 14 1" fill="none" stroke-width="3.2" />
        <g class="bow">
          <path d="M168 50l-18-12 2 23zM168 50l18-12-2 23z" fill="#EFA9C3" stroke-width="3" />
          <circle cx="168" cy="50" r="5.5" fill="#F6C9DA" stroke-width="3" />
        </g>
      </g>
    </svg>
  </div>

  <section class="closing scallop-top">
    <svg class="paws" viewBox="0 0 240 44" aria-hidden="true">
      <g stroke="#3A1D3C" stroke-width="4" stroke-linecap="round" fill="#F7E1C3">
        <ellipse cx="76" cy="24" rx="24" ry="16" />
        <ellipse cx="164" cy="24" rx="24" ry="16" />
        <path d="M66 12v9M76 10v10M86 12v9M154 12v9M164 10v10M174 12v9" fill="none" stroke-width="3" />
      </g>
    </svg>

    <div class="wrap">
      <Sparkle class="cs cs1" />
      <Sparkle class="cs cs2" style="animation-delay:1s" />
      <h2>Book your pet's next groom</h2>
      <p class="sub">Call or text Mary at {business.phone}.</p>
      <div class="ctas">
        <a class="btn btn-main" href={business.phoneHref}><Icon name="phone" />Call now</a>
        <a class="btn btn-alt" href={business.smsHref}><Icon name="chat" />Send a text</a>
      </div>
    </div>
  </section>
</div>

<script>
  const mascot = document.querySelector<HTMLElement>('[data-mascot]');
  if (mascot && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          mascot.classList.add('up');
          io.disconnect();
        }
      },
      { threshold: 0.2, rootMargin: '0px 0px -10% 0px' },
    );
    io.observe(mascot.parentElement!);
  } else {
    mascot?.classList.add('up');
  }
</script>

<style>
  .closing-wrap { position: relative; margin-top: 150px; }

  .mascot {
    position: absolute; left: 50%; top: -152px;
    width: 190px;
    translate: -50% 0;
    z-index: 0;
    transform: translateY(70px);
    transition: transform .8s var(--bounce);
  }
  .mascot:global(.up) { transform: translateY(0); }
  .head { width: 100%; overflow: visible; }
  .eyes { transform-box: fill-box; transform-origin: center; animation: blink 4.5s infinite; }
  .ear { transform-box: fill-box; }
  .ear-l { transform-origin: 80% 10%; }
  .ear-r { transform-origin: 20% 10%; }
  .mascot:hover .ear-l { animation: flop .6s ease-in-out; }
  .mascot:hover .ear-r { animation: flop-r .6s ease-in-out; }
  .mascot:hover .bow { animation: wiggle .6s; transform-box: fill-box; transform-origin: center; }
  @keyframes blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(.1); } }
  @keyframes flop { 50% { rotate: 14deg; } }
  @keyframes flop-r { 50% { rotate: -14deg; } }

  .closing {
    --edge: var(--bubble);
    position: relative; z-index: 1;
    background: var(--bubble);
    text-align: center;
    padding: 80px 0 76px;
  }
  .paws {
    position: absolute; left: 50%; top: -30px;
    width: 190px; translate: -50% 0;
    z-index: 2;
  }
  .closing h2 { max-width: 14ch; margin: 0 auto 12px; }
  .closing .sub { margin: 0 auto; }
  .closing .ctas { justify-content: center; }
  .closing .wrap { position: relative; }
  .cs { position: absolute; color: var(--paper); }
  .cs1 { width: 28px; left: 6%; top: -46px; }
  .cs2 { width: 18px; right: 8%; top: -20px; color: var(--sun); }

  @media (min-width: 900px) {
    .mascot, .paws { left: 76%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mascot { transform: none; }
  }
</style>
