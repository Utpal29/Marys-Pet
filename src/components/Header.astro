---
import { business } from '../data/site';
import Icon from './Icon.astro';

const links = [
  { href: '#services', label: 'Services' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#meet-mary', label: 'Meet Mary' },
  { href: '#faq', label: 'FAQ' },
  { href: '#visit', label: 'Hours & map' },
];
---
<div class="preview">
  <b>Preview design</b> for {business.name}. Photos are placeholders until we add yours.
</div>

<header class="site-header">
  <div class="nav">
    <a class="logo" href="#top" aria-label={`${business.name}, home`}>
      <svg class="logo-mark" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="20" fill="#3A1D3C" />
        <g fill="#F6C9DA">
          <ellipse class="pad" cx="20" cy="25" rx="7" ry="6" />
          <circle class="toe t1" cx="11.5" cy="17" r="3.2" />
          <circle class="toe t2" cx="17" cy="12" r="3.2" />
          <circle class="toe t3" cx="23" cy="12" r="3.2" />
          <circle class="toe t4" cx="28.5" cy="17" r="3.2" />
        </g>
      </svg>
      <span class="logo-text">{business.shortName}<small>Pet Grooming Studio</small></span>
    </a>

    <nav class="navlinks" aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <span class="status" data-status title="Studio hours">
      <i class="dot" aria-hidden="true"></i>
      <span class="zzz" aria-hidden="true"><b>z</b><b>z</b></span>
      <span class="label" data-status-label>Hours</span>
    </span>

    <a class="btn btn-main btn-sm nav-call" href={business.phoneHref}>
      <Icon name="phone" size={17} />Call {business.phone}
    </a>
  </div>
</header>

<script>
  import { hours } from '../data/site';
  import { studioStatus } from '../lib/hours';

  const el = document.querySelector<HTMLElement>('[data-status]');
  const label = el?.querySelector<HTMLElement>('[data-status-label]');
  if (el && label) {
    const s = studioStatus(hours);
    el.dataset.state = s.open ? 'open' : 'closed';
    if (s.open) {
      label.innerHTML = `<span class="long">Open now · </span>till ${s.until}`;
      el.title = `Open now until ${s.until}`;
    } else {
      const when = s.when ? `${s.when} ` : '';
      label.innerHTML = `<span class="long">Napping · </span>back ${when}${s.time}`;
      el.title = `Closed right now. Opens ${when}${s.time}`;
    }
  }
</script>

<style>
  .preview {
    background: var(--plum);
    color: var(--paper);
    font-size: 13px;
    line-height: 1.4;
    text-align: center;
    padding: 8px 14px;
    padding-top: calc(8px + env(safe-area-inset-top, 0px));
  }
  .preview b { color: var(--sun); }

  .site-header {
    position: sticky; top: 0; z-index: 30;
    background: rgba(246, 201, 218, .9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .nav {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 10px 16px; max-width: 1140px; margin: 0 auto;
  }

  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; flex: none; }
  .logo-mark { width: 40px; height: 40px; flex: none; overflow: visible; }
  .logo-text {
    font-family: var(--display); font-weight: 650; font-size: 22px; line-height: 1;
  }
  .logo-text small {
    display: block; font-family: var(--body); font-weight: 600; font-size: 12px;
    color: var(--plum-soft); margin-top: 3px; white-space: nowrap;
  }
  /* The toes bop one after another when you hover the logo, like a little wave. */
  .toe { transform-box: fill-box; transform-origin: center; }
  .logo:hover .toe { animation: bop .5s var(--bounce); }
  .logo:hover .t2 { animation-delay: .06s; }
  .logo:hover .t3 { animation-delay: .12s; }
  .logo:hover .t4 { animation-delay: .18s; }
  .logo:hover .logo-mark { animation: wiggle .6s ease-in-out; }
  @keyframes bop { 50% { transform: translateY(-3px) scale(1.2); } }

  .navlinks { display: none; gap: 24px; font-weight: 600; font-size: 15px; }
  .navlinks a { text-decoration: none; position: relative; }
  .navlinks a::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -4px; height: 3px; border-radius: 3px;
    background: var(--plum); scale: 0 1; transition: scale .25s var(--bounce);
  }
  .navlinks a:hover::after { scale: 1 1; }

  .status {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: 13px; font-weight: 700;
    background: var(--paper);
    border-radius: 999px;
    padding: 7px 12px;
    white-space: nowrap;
  }
  .status :global(.long) { display: none; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #B9A5B9; display: none; }
  .zzz { display: none; font-family: var(--hand); font-size: 17px; line-height: 1; color: var(--plum-soft); position: relative; width: 14px; height: 14px; }
  .zzz b { position: absolute; font-weight: 700; animation: snooze 2.4s ease-in-out infinite; }
  .zzz b:first-child { left: 0; top: 2px; font-size: 13px; }
  .zzz b:last-child { left: 6px; top: -4px; animation-delay: 1.2s; }
  @keyframes snooze {
    0% { opacity: 0; transform: translate(0, 4px) scale(.6); }
    30%, 70% { opacity: 1; }
    100% { opacity: 0; transform: translate(4px, -6px) scale(1.1); }
  }
  .status[data-state="open"] .dot {
    display: block; background: #2E9E5B;
    box-shadow: 0 0 0 3px rgba(46, 158, 91, .2);
    animation: pulse 2s ease-out infinite;
  }
  .status[data-state="closed"] .zzz { display: block; }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(46, 158, 91, .45); }
    100% { box-shadow: 0 0 0 9px rgba(46, 158, 91, 0); }
  }

  .nav-call { display: none; }

  @media (min-width: 420px) {
    .status :global(.long) { display: inline; }
  }
  @media (min-width: 960px) {
    .navlinks { display: flex; }
    .nav-call { display: inline-flex; }
    .nav { padding: 12px 20px; }
  }
</style>
