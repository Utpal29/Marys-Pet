---
// Soap bubbles that drift up the hero. Tap one to pop it.
interface Props { count?: number }
const { count = 14 } = Astro.props;
---
<div class="bubbles" data-bubbles data-count={count} aria-hidden="true"></div>

<script>
  const layers = document.querySelectorAll<HTMLElement>('[data-bubbles]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rand = (min: number, max: number) => min + Math.random() * (max - min);

  layers.forEach((layer) => {
    const wanted = Number(layer.dataset.count) || 14;
    const count = innerWidth < 700 ? Math.ceil(wanted * 0.6) : wanted;

    const setHeight = () => layer.style.setProperty('--h', `${layer.offsetHeight + 120}px`);
    setHeight();
    new ResizeObserver(setHeight).observe(layer);

    function spawn(firstRound: boolean) {
      const b = document.createElement('span');
      b.className = 'bubble';
      const size = rand(16, 64);
      b.style.setProperty('--s', `${size}px`);
      b.style.left = `${rand(0, 96)}%`;
      b.style.setProperty('--dur', `${rand(11, 20)}s`);
      b.style.setProperty('--sway', `${rand(10, 34)}px`);
      b.style.setProperty('--sway-dur', `${rand(2.6, 4.2)}s`);
      // Start mid-flight on first paint so the hero isn't empty for the first few seconds.
      b.style.setProperty('--delay', firstRound ? `${-rand(0, 18)}s` : '0s');
      if (still) b.style.bottom = `${rand(8, 85)}%`;
      b.innerHTML = '<i></i>';
      b.addEventListener('pointerdown', () => pop(b), { once: true });
      layer.append(b);
    }

    function pop(b: HTMLElement) {
      const rect = b.getBoundingClientRect();
      const host = layer.getBoundingClientRect();
      const word = document.createElement('span');
      word.className = 'pop-word';
      word.textContent = Math.random() > 0.5 ? 'pop!' : 'plip!';
      word.style.left = `${rect.left - host.left + rect.width / 2}px`;
      word.style.top = `${rect.top - host.top + rect.height / 2}px`;
      layer.append(word);
      b.classList.add('popped');
      setTimeout(() => b.remove(), 260);
      setTimeout(() => word.remove(), 800);
      setTimeout(() => spawn(false), 1400);
    }

    for (let i = 0; i < count; i++) spawn(true);
  });
</script>

<style is:global>
  .bubbles {
    position: absolute; inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .bubble {
    position: absolute;
    bottom: -80px;
    width: var(--s); height: var(--s);
    animation: bubble-rise var(--dur) linear var(--delay) infinite;
    cursor: pointer;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }
  .bubble i {
    display: block; width: 100%; height: 100%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 28%, rgba(255,255,255,.95) 0 9%, rgba(255,255,255,0) 10%),
      radial-gradient(circle at 70% 75%, rgba(255,255,255,.5) 0 5%, rgba(255,255,255,0) 6%),
      radial-gradient(circle at 50% 50%, rgba(255,255,255,0) 58%, rgba(255,255,255,.55) 70%, rgba(205,235,221,.6) 82%, rgba(214,196,255,.7) 92%, rgba(255,255,255,.9) 100%);
    box-shadow: inset 0 0 6px rgba(255,255,255,.6);
    animation: bubble-sway var(--sway-dur) ease-in-out infinite alternate;
    transition: transform .25s ease-out, opacity .25s ease-out;
  }
  .bubble.popped { pointer-events: none; }
  .bubble.popped i { transform: scale(1.5); opacity: 0; }
  .pop-word {
    position: absolute;
    translate: -50% -50%;
    font-family: var(--hand); font-weight: 700; font-size: 26px; color: var(--plum);
    pointer-events: none;
    animation: pop-word .8s ease-out forwards;
  }
  @keyframes bubble-rise {
    to { transform: translateY(calc(-1 * var(--h, 900px))); }
  }
  @keyframes bubble-sway {
    from { transform: translateX(calc(-1 * var(--sway))); }
    to { transform: translateX(var(--sway)); }
  }
  @keyframes pop-word {
    0% { opacity: 0; scale: .5; }
    25% { opacity: 1; scale: 1.1; }
    100% { opacity: 0; scale: 1; transform: translateY(-28px) rotate(-8deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bubble { animation: none; }
    .bubble i { animation: none; }
  }
</style>
