---
import { business, reviews } from '../data/site';
import dogBandana from '../assets/stickers/dog-bandana.png';
import Photo from './Photo.astro';
import Sticker from './Sticker.astro';
import Paw from './doodles/Paw.astro';

const colors = ['paper', 'pink', 'mint', 'butter'];
const tilts = [-1.6, 1.2, 1.4, -1.2];
---
<section class="reviews" id="reviews" aria-labelledby="reviews-title">
  <Sticker src={dogBandana} width={150} class="review-sticker" />
  <div class="wrap">
    <h2 id="reviews-title">Hamilton pet parents love Mary</h2>
    <p class="sub">{business.rating} stars from {business.reviewCount} reviews on Google.</p>

    <figure class="featured">
      <blockquote><p>{reviews.featured.quote}</p></blockquote>
      <figcaption>{reviews.featured.cite}</figcaption>
    </figure>

    <ul class="grid">
      {reviews.list.map((r, i) => (
        <li class:list={['review', colors[i % colors.length]]} style={`--tilt:${tilts[i % tilts.length]}deg`}>
          <blockquote class="speech">
            <span class="paws" role="img" aria-label="5 out of 5">
              {[0, 1, 2, 3, 4].map(() => <Paw />)}
            </span>
            <p>“{r.quote}”</p>
          </blockquote>
          <div class="who">
            <Photo photo={r.photo} width={64} ratio={1} class="avatar" />
            <cite><b>{r.who}</b><span>{r.pet}</span></cite>
          </div>
        </li>
      ))}
    </ul>

    <a class="google" href={business.mapsSearch} target="_blank" rel="noopener">
      Read all {business.reviewCount} reviews on Google →
    </a>
  </div>
</section>

<style>
  .reviews {
    background: var(--plum);
    color: var(--paper);
    border-radius: 36px;
    margin: 60px 12px 0;
  }
  .reviews h2 { color: var(--paper); max-width: 13ch; }
  .reviews .sub { color: #D9C6DA; }

  .review-sticker {
    position: absolute; right: 14px; top: -78px;
    width: 104px; rotate: 6deg; z-index: 2;
  }

  .featured { margin: 56px 0 44px; }
  .featured p {
    font-family: var(--display); font-weight: 500;
    font-size: clamp(26px, 5.2vw, 42px); line-height: 1.15;
    max-width: 24ch;
    position: relative;
  }
  .featured p::before {
    content: "“";
    position: absolute; left: -.08em; top: -.55em;
    font-size: 2.6em; line-height: 1; color: var(--bubble-deep);
    opacity: .6; z-index: -1;
  }
  .featured blockquote { position: relative; z-index: 0; }
  .featured figcaption { color: var(--bubble); font-weight: 600; margin-top: 10px; }

  .grid { list-style: none; display: grid; gap: 34px 22px; }
  .review { rotate: var(--tilt); transition: rotate .3s var(--bounce); }
  .review:hover { rotate: 0deg; }

  .speech {
    --bg: var(--paper);
    position: relative;
    background: var(--bg); color: var(--plum);
    border-radius: 26px;
    padding: 20px 22px 22px;
    box-shadow: 0 6px 0 rgba(0, 0, 0, .18);
  }
  /* The little tail pointing down at the pet */
  .speech::after {
    content: ""; position: absolute; left: 34px; bottom: -16px;
    width: 30px; height: 20px;
    background: var(--bg);
    clip-path: polygon(0 0, 100% 0, 12% 100%);
  }
  .pink .speech { --bg: var(--bubble); }
  .mint .speech { --bg: var(--mint); }
  .butter .speech { --bg: var(--butter); }
  .speech p { font-size: 18px; line-height: 1.45; font-weight: 500; }
  .paws { display: flex; gap: 3px; color: var(--bubble-deep); margin-bottom: 8px; }
  .pink .paws { color: var(--plum); }
  .paws :global(svg) { width: 18px; }

  .who { display: flex; align-items: center; gap: 12px; margin: 22px 0 0 10px; }
  .who :global(.avatar) {
    width: 60px; height: 60px; border-radius: 50%; object-fit: cover;
    border: 3px solid var(--paper);
    flex: none;
  }
  cite { font-style: normal; font-size: 14px; line-height: 1.3; color: #D9C6DA; }
  cite b { display: block; color: var(--paper); font-size: 16px; }

  .google {
    display: inline-flex; margin-top: 40px;
    color: var(--sun); font-weight: 700; font-size: 17px;
    text-underline-offset: 4px;
  }

  @media (min-width: 700px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .review-sticker { width: 150px; right: 40px; top: -112px; }
  }
  @media (min-width: 900px) {
    .reviews { margin: 80px 24px 0; }
  }
</style>
